---
import type { CollectionEntry } from "astro:content";

interface RelatedPost {
  id: string;
  title: string;
}

interface Props {
  project: CollectionEntry<"projects">;
  relatedPosts: RelatedPost[];
  statusLabel: string;
}

const { project, relatedPosts, statusLabel } = Astro.props;
---

<main class="desktop-list-shell" aria-labelledby="desktop-project-title">
  <section class="desktop-list-window desktop-detail-window">
    <header class="desktop-list-window__titlebar">
      <span aria-hidden="true">🖥️</span>
      <h1 id="desktop-project-title">{project.data.title}</h1>
    </header>
    <div class="desktop-list-window__toolbar">
      <a href="/">Desktop</a>
      <a href="/projects">Projects</a>
      <a href="/blog">Journal</a>
    </div>
    <div class="desktop-list-window__address">
      Address · C:\PortfolioOS\Projects\{project.id}
    </div>
    <div class="desktop-detail-body">
      <p><strong>Status:</strong> {statusLabel}</p>
      <p>{project.data.description}</p>
      {
        project.data.technologies.length > 0 && (
          <p>
            <strong>Stack:</strong> {project.data.technologies.join(", ")}
          </p>
        )
      }
      <div class="desktop-detail-content">
        <slot />
      </div>
      {
        relatedPosts.length > 0 && (
          <section>
            <h2>Related documents</h2>
            <ul>
              {relatedPosts.map((post) => (
                <li>
                  <a href={`/blog/${post.id}`}>{post.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </section>
</main>
