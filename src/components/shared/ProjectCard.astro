---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  showMedia?: boolean;
  variant?: "default" | "compact";
}

const { project, showMedia = false, variant = "default" } = Astro.props;

const statusLabels = {
  planning: "Planning",
  "in-development": "In development",
  completed: "Completed",
  archived: "Archived",
} as const;
---

{
  variant === "compact" ? (
    <a class="project-card project-card--compact" href={`/projects/${project.id}`}>
      <div class="project-card__content">
        <p class="project-card__status">{statusLabels[project.data.status]}</p>
        <h3>{project.data.title}</h3>
        <p>{project.data.description}</p>
        {project.data.technologies.length > 0 && (
          <ul class="project-card__technologies" aria-label="Technologies">
            {project.data.technologies
              .slice(0, 2)
              .map((technology) => <li>{technology}</li>)}
          </ul>
        )}
      </div>
    </a>
  ) : (
    <article class="project-card">
      {
        showMedia && (
          <div class="project-card__media">
            {project.data.coverImage ? (
              <img
                src={project.data.coverImage}
                alt={`Preview of ${project.data.title}`}
                loading="lazy"
              />
            ) : (
              <div class="project-card__media-placeholder">
                <span>Project media</span>
                <small>TODO(Codex): Add optimized video preview component.</small>
              </div>
            )}
          </div>
        )
      }

      <div class="project-card__content">
        <p class="project-card__status">{statusLabels[project.data.status]}</p>
        <h2><a href={`/projects/${project.id}`}>{project.data.title}</a></h2>
        <p>{project.data.description}</p>

        {
          project.data.technologies.length > 0 && (
            <ul class="project-card__technologies" aria-label="Technologies">
              {project.data.technologies.map((technology) => <li>{technology}</li>)}
            </ul>
          )
        }

        <a class="project-card__link" href={`/projects/${project.id}`}>
          Explore project <span aria-hidden="true">→</span>
        </a>
      </div>
    </article>
  )
}

<style>
  .project-card {
    display: grid;
    height: 100%;
    overflow: hidden;
    border: 1px solid currentColor;
    grid-template-rows: auto 1fr;
  }

  .project-card--compact {
    min-width: 0;
    border-color: rgb(255 255 255 / 11%);
    border-radius: 0.8rem;
    background: rgb(255 255 255 / 4%);
    color: #eaf4f1;
    text-decoration: none;
    transition:
      border-color 140ms ease,
      background 140ms ease,
      transform 140ms ease;
  }

  .project-card--compact:hover,
  .project-card--compact:focus-visible {
    border-color: rgb(130 247 213 / 45%);
    background: rgb(130 247 213 / 7%);
    outline: 0;
    transform: translateY(-2px);
  }

  .project-card--compact .project-card__content {
    min-width: 0;
    padding: 0.7rem 0.75rem;
  }

  .project-card--compact h3 {
    margin: 0;
    overflow: hidden;
    font-size: 0.95rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .project-card--compact .project-card__content > p:not(.project-card__status) {
    display: -webkit-box;
    margin: 0.3rem 0 0.45rem;
    overflow: hidden;
    color: #9db1ac;
    font-size: 0.7rem;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .project-card--compact .project-card__status {
    margin-bottom: 0.3rem;
    color: #82f7d5;
    font-size: 0.62rem;
  }

  .project-card--compact .project-card__technologies {
    margin: auto 0 0;
    gap: 0.3rem;
  }

  .project-card--compact .project-card__technologies li {
    padding: 0.18rem 0.35rem;
    border-color: rgb(130 247 213 / 22%);
    color: #bce8dc;
    font-size: 0.62rem;
  }

  .project-card__media img,
  .project-card__media-placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .project-card__media img {
    object-fit: cover;
  }

  .project-card__media-placeholder {
    display: grid;
    padding: 1rem;
    background: rgb(0 0 0 / 8%);
    place-content: center;
    text-align: center;
  }

  .project-card__media-placeholder small {
    max-width: 18rem;
    margin-top: 0.35rem;
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  }

  .project-card__content {
    display: flex;
    padding: 1.5rem;
    flex-direction: column;
  }

  .project-card__status {
    margin: 0 0 0.5rem;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  h2 a {
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.15em;
  }

  .project-card__technologies {
    display: flex;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .project-card__technologies li {
    padding: 0.3rem 0.5rem;
    border: 1px solid currentColor;
    font-size: 0.78rem;
  }

  .project-card__link {
    margin-top: auto;
    font-weight: 800;
  }

  a:focus-visible {
    outline: 3px solid var(--focus-color);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card--compact {
      transition: none;
    }
  }
</style>
