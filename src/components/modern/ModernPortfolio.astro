---
import type { CollectionEntry } from "astro:content";

import ProjectCard from "../shared/ProjectCard.astro";
import ModernSidebar from "./ModernSidebar.vue";

interface Props {
  projects: CollectionEntry<"projects">[];
  posts: CollectionEntry<"blog">[];
}

const { projects, posts } = Astro.props;
const featuredProjects = projects.filter((project) => project.data.featured);
const latestPosts = [...posts]
  .sort(
    (first, second) =>
      second.data.publishedAt.getTime() - first.data.publishedAt.getTime(),
  )
  .slice(0, 3);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
  }).format(date);
---

<section class="modern-dashboard" aria-labelledby="modern-title">
  <ModernSidebar client:load />

  <div class="modern-dashboard__content modern-dashboard__content--simple">
    <header id="modern-overview" class="modern-home-header">
      <div>
        <p class="eyebrow">Workstation</p>
        <h1 id="modern-title">Richard Vázquez</h1>
        <p class="modern-home-header__summary">
          Computer engineer · Independent developer · Puerto Rico
        </p>
      </div>
      <div class="modern-home-header__meta" id="modern-about">
        <span>{projects.length} projects</span>
        <span>{posts.length} journal notes</span>
        <a href="mailto:richardvb76@gmail.com">Email</a>
      </div>
    </header>

    <div class="modern-home-body">
      <section
        id="modern-projects"
        class="modern-home-panel"
        aria-labelledby="featured-projects-title"
      >
        <header class="modern-home-panel__heading">
          <h2 id="featured-projects-title">Projects</h2>
          <a href="/projects">Open folder</a>
        </header>
        <div class="modern-project-grid">
          {
            featuredProjects.map((project) => (
              <ProjectCard project={project} variant="compact" />
            ))
          }
        </div>
      </section>

      <aside
        id="modern-recent"
        class="modern-home-panel modern-home-panel--side"
        aria-labelledby="modern-recent-title"
      >
        <header class="modern-home-panel__heading">
          <h2 id="modern-recent-title">Journal</h2>
          <a href="/blog">Open</a>
        </header>
        <ul class="modern-home-journal">
          {
            latestPosts.map((post) => (
              <li>
                <a href={`/blog/${post.id}`}>
                  <strong>{post.data.title}</strong>
                  <small>
                    {post.data.category} · {formatDate(post.data.publishedAt)}
                  </small>
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</section>
