---
import { getCollection, render } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

type Post = Awaited<ReturnType<typeof getCollection<"blog">>>[number];

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const relatedProject = post.data.relatedProject
  ? (await getCollection("projects")).find(
      (project) => project.id === post.data.relatedProject,
    )
  : undefined;

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title={`${post.data.title} | PortfolioOS`}
  description={post.data.description}
>
  <main class="article-page">
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumbs">
        <li><a href="/">PortfolioOS</a></li>
        <li><a href="/blog">Blog</a></li>
        <li aria-current="page">{post.data.title}</li>
      </ol>
    </nav>

    <article>
      <header class="article-header">
        <p class="eyebrow">{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p class="article-summary">{post.data.description}</p>

        <dl class="article-dates">
          <div>
            <dt>Published</dt>
            <dd>
              <time datetime={post.data.publishedAt.toISOString()}>
                {dateFormatter.format(post.data.publishedAt)}
              </time>
            </dd>
          </div>
          {
            post.data.updatedAt && (
              <div>
                <dt>Updated</dt>
                <dd>
                  <time datetime={post.data.updatedAt.toISOString()}>
                    {dateFormatter.format(post.data.updatedAt)}
                  </time>
                </dd>
              </div>
            )
          }
        </dl>

        {
          post.data.tags.length > 0 && (
            <ul class="tag-list" aria-label="Article tags">
              {post.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )
        }
      </header>

      {
        post.data.coverImage && (
          <img
            class="article-cover"
            src={post.data.coverImage}
            alt={`Cover image for ${post.data.title}`}
          />
        )
      }

      <div class="article-content">
        <Content />
      </div>

      {
        relatedProject && (
          <aside class="related-project" aria-labelledby="related-project-title">
            <p class="eyebrow">Related project</p>
            <h2 id="related-project-title">{relatedProject.data.title}</h2>
            <p>{relatedProject.data.description}</p>
            <a href={`/projects/${relatedProject.id}`}>Explore project</a>
          </aside>
        )
      }
    </article>
  </main>
</BaseLayout>

<style>
  .article-page {
    width: min(100% - 2rem, 68rem);
    margin: 0 auto;
    padding: 5rem 0;
  }

  .breadcrumbs {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .breadcrumbs li:not(:last-child)::after {
    margin-left: 0.5rem;
    content: "/";
    opacity: 0.55;
  }

  .article-header {
    max-width: 52rem;
    margin: 4rem 0;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.8rem, 9vw, 6rem);
    line-height: 1;
  }

  .article-summary {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.65;
  }

  .article-dates {
    display: flex;
    margin: 1.5rem 0;
    gap: 2rem;
  }

  .article-dates div {
    display: grid;
    gap: 0.2rem;
  }

  .article-dates dt {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-dates dd {
    margin: 0;
  }

  .tag-list {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .tag-list li {
    padding: 0.4rem 0.65rem;
    border: 1px solid currentColor;
  }

  .article-cover {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 3rem;
    border: 1px solid currentColor;
  }

  .article-content {
    max-width: 46rem;
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .related-project {
    max-width: 46rem;
    margin-top: 5rem;
    padding: 1.5rem;
    border: 1px solid currentColor;
  }

  .related-project h2 {
    margin-top: 0;
  }

  .related-project a {
    font-weight: 800;
  }

  a:focus-visible {
    outline: 3px solid var(--focus-color);
    outline-offset: 3px;
  }

  @media (max-width: 36rem) {
    .article-page {
      padding-top: 4.5rem;
    }

    .article-header {
      margin: 3rem 0;
    }

    .article-dates {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
