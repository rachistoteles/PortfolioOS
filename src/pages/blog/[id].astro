---
import { getCollection, render } from "astro:content";

import DesktopArticleDetail from "../../components/themes/desktop/DesktopArticleDetail.astro";
import GeoCitiesArticleDetail from "../../components/themes/geocities/GeoCitiesArticleDetail.astro";
import InstitutionalArticleDetail from "../../components/themes/institutional/InstitutionalArticleDetail.astro";
import ModernArticleDetail from "../../components/themes/modern/ModernArticleDetail.astro";
import Web2ArticleDetail from "../../components/themes/web2/Web2ArticleDetail.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const relatedProject = post.data.relatedProject
  ? (await getCollection("projects")).find(
      (project) => project.id === post.data.relatedProject,
    )
  : undefined;

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const publishedLabel = dateFormatter.format(post.data.publishedAt);
const updatedLabel = post.data.updatedAt
  ? dateFormatter.format(post.data.updatedAt)
  : undefined;

const articleProps = {
  post,
  publishedLabel,
  relatedProject,
};
---

<BaseLayout
  title={`${post.data.title} | PortfolioOS`}
  description={post.data.description}
>
  <div class="theme-surface" data-theme-surface="modern">
    <ModernArticleDetail {...articleProps} updatedLabel={updatedLabel}>
      <Content />
    </ModernArticleDetail>
  </div>
  <div class="theme-surface" data-theme-surface="desktop">
    <DesktopArticleDetail {...articleProps}>
      <Content />
    </DesktopArticleDetail>
  </div>
  <div class="theme-surface" data-theme-surface="institutional">
    <InstitutionalArticleDetail {...articleProps}>
      <Content />
    </InstitutionalArticleDetail>
  </div>
  <div class="theme-surface" data-theme-surface="geocities">
    <GeoCitiesArticleDetail {...articleProps}>
      <Content />
    </GeoCitiesArticleDetail>
  </div>
  <div class="theme-surface" data-theme-surface="web2">
    <Web2ArticleDetail {...articleProps}>
      <Content />
    </Web2ArticleDetail>
  </div>
</BaseLayout>
