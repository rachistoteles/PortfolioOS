---
import { getCollection } from "astro:content";

import ThemedBlogIndex from "../../components/themes/shared/ThemedBlogIndex.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort(
    (first, second) =>
      second.data.publishedAt.valueOf() -
      first.data.publishedAt.valueOf(),
  );
---

<BaseLayout
  title="Technical Journal | PortfolioOS"
  description="Coding guides, development logs, useful tools, experiments, and technical notes."
>
  <ThemedBlogIndex posts={posts} />
</BaseLayout>
