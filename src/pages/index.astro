---
import { getCollection } from "astro:content";

import ModernPortfolio from "../components/modern/ModernPortfolio.astro";
import GeoCitiesHome from "../components/themes/geocities/GeoCitiesHome.astro";
import InstitutionalHome from "../components/themes/institutional/InstitutionalHome.astro";
import Web2Home from "../components/themes/web2/Web2Home.astro";
import XPDesktop from "../components/xp/XPDesktop.astro";
import type {
  ArticleSummary,
  ProjectSummary,
} from "../components/xp/desktopTypes";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort(
  (first, second) => first.data.order - second.data.order,
);

const publishedPosts = (await getCollection("blog")).filter(
  (post) => !post.data.draft,
);

const projectSummaries = projects.map(
  ({ id, data }) =>
    ({
      id,
      title: data.title,
      description: data.description,
      status: data.status,
      featured: data.featured,
      order: data.order,
      coverImage: data.coverImage,
      repositoryUrl: data.repositoryUrl,
      liveUrl: data.liveUrl,
      technologies: data.technologies,
      features: data.features,
      relatedPosts: data.relatedPosts,
    }) satisfies ProjectSummary,
);

const articleSummaries = publishedPosts
  .sort(
    (first, second) =>
      second.data.publishedAt.getTime() - first.data.publishedAt.getTime(),
  )
  .map(
    ({ id, data }) =>
      ({
        id,
        title: data.title,
        description: data.description,
        publishedAt: data.publishedAt.toISOString(),
        updatedAt: data.updatedAt?.toISOString(),
        featured: data.featured,
        category: data.category,
        tags: data.tags,
        relatedProject: data.relatedProject,
        coverImage: data.coverImage,
      }) satisfies ArticleSummary,
  );
---

<BaseLayout
  title="PortfolioOS | Richard's Developer Portfolio"
  description="A multi-era developer portfolio containing projects, demonstrations, coding guides, and development logs."
>
  <main class="portfolio-main">
    <div class="theme-surface" data-theme-surface="desktop">
      <XPDesktop
        projects={projectSummaries}
        articles={articleSummaries}
      />
    </div>

    <div class="theme-surface" data-theme-surface="modern">
      <ModernPortfolio
        projects={projects}
        posts={publishedPosts}
      />
    </div>

    <div class="theme-surface" data-theme-surface="institutional">
      <InstitutionalHome
        projects={projects}
        posts={publishedPosts}
      />
    </div>

    <div class="theme-surface" data-theme-surface="geocities">
      <GeoCitiesHome
        projects={projects}
        posts={publishedPosts}
      />
    </div>

    <div class="theme-surface" data-theme-surface="web2">
      <Web2Home
        projects={projects}
        posts={publishedPosts}
      />
    </div>
  </main>
</BaseLayout>
