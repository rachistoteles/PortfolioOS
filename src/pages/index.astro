---
import { getCollection } from "astro:content";

import ModernPortfolio from "../components/modern/ModernPortfolio.astro";
import PortfolioTopBar from "../components/shared/PortfolioTopBar.astro";
import XPDesktop from "../components/xp/XPDesktop.astro";
import type {
  ArticleSummary,
  ProjectSummary,
} from "../components/xp/desktopTypes";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort(
  (first, second) => first.data.order - second.data.order,
);

const publishedPosts = (await getCollection("blog")).filter(
  (post) => !post.data.draft,
);

const projectSummaries = projects.map(
  ({ id, data }) =>
    ({
      id,
      title: data.title,
      description: data.description,
      status: data.status,
      featured: data.featured,
      order: data.order,
      coverImage: data.coverImage,
      repositoryUrl: data.repositoryUrl,
      liveUrl: data.liveUrl,
      technologies: data.technologies,
      features: data.features,
      relatedPosts: data.relatedPosts,
    }) satisfies ProjectSummary,
);

const articleSummaries = publishedPosts
  .sort(
    (first, second) =>
      second.data.publishedAt.getTime() - first.data.publishedAt.getTime(),
  )
  .map(
    ({ id, data }) =>
      ({
        id,
        title: data.title,
        description: data.description,
        publishedAt: data.publishedAt.toISOString(),
        updatedAt: data.updatedAt?.toISOString(),
        featured: data.featured,
        category: data.category,
        tags: data.tags,
        relatedProject: data.relatedProject,
        coverImage: data.coverImage,
      }) satisfies ArticleSummary,
  );
---

<BaseLayout
  title="PortfolioOS | Richard's Developer Portfolio"
  description="A dual-interface developer portfolio containing projects, demonstrations, coding guides, and development logs."
>
  <div class="portfolio-app">
    <PortfolioTopBar />
    <main class="portfolio-main">
    <div class="xp-interface">
      <XPDesktop
        projects={projectSummaries}
        articles={articleSummaries}
      />
    </div>

    <div class="modern-interface">
      <ModernPortfolio
        projects={projects}
        posts={publishedPosts}
      />
    </div>

    <section id="about" class="about-placeholder">
      <p class="eyebrow">About</p>
      <h2>Richard Vázquez Burgos</h2>

      <p>
        Computer engineer and application developer building
        full-stack tools, creative software, and experimental
        mathematical systems.
      </p>

      <p class="todo-note">
        TODO(Codex): Replace this placeholder with the complete
        biography, experience, skills, résumé link, contact methods,
        and current technical focus.
      </p>
    </section>
    </main>
  </div>
</BaseLayout>
