---
import { getCollection, render } from "astro:content";

import LatticeMatrixCaseStudy from "../../components/projects/lattice-matrix/LatticeMatrixCaseStudy.vue";
import MekbudaCaseStudy from "../../components/projects/mekbuda/MekbudaCaseStudy.vue";
import NexusWaveCaseStudy from "../../components/projects/nexus-wave/NexusWaveCaseStudy.vue";
import DesktopProjectDetail from "../../components/themes/desktop/DesktopProjectDetail.astro";
import GeoCitiesProjectDetail from "../../components/themes/geocities/GeoCitiesProjectDetail.astro";
import InstitutionalProjectDetail from "../../components/themes/institutional/InstitutionalProjectDetail.astro";
import ModernProjectDetail from "../../components/themes/modern/ModernProjectDetail.astro";
import ThemedCaseStudyChrome from "../../components/themes/shared/ThemedCaseStudyChrome.astro";
import Web2ProjectDetail from "../../components/themes/web2/Web2ProjectDetail.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const relatedPostIds = new Set(project.data.relatedPosts);

const relatedPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && relatedPostIds.has(post.id))
  .sort(
    (first, second) =>
      second.data.publishedAt.valueOf() -
      first.data.publishedAt.valueOf(),
  );

const relatedPostCards = relatedPosts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  href: `/blog/${post.id}`,
  date: new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(post.data.publishedAt),
  category: project.data.title,
}));

const relatedForThemes = relatedPosts.map((post) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
}));

const statusLabels = {
  planning: "Planning",
  "in-development": "In development",
  completed: "Completed",
  archived: "Archived",
} as const;

const statusLabel = statusLabels[project.data.status];

const isNexusWave = project.id === "nexus-wave";
const isMekbuda = project.id === "mekbuda";
const isLatticeMatrix = project.id === "lattice-matrix";
const hasCustomCaseStudy =
  isNexusWave || isMekbuda || isLatticeMatrix;

const caseStudyProject = {
  title: project.data.title,
  description: project.data.description,
  status: project.data.status,
  technologies: [...project.data.technologies],
  features: project.data.features.map((feature) => ({
    title: feature.title,
    description: feature.description,
  })),
};

const detailProps = {
  project,
  relatedPosts: relatedForThemes,
  statusLabel,
};
---

<BaseLayout
  title={`${project.data.title} | PortfolioOS`}
  description={project.data.description}
>
  {
    hasCustomCaseStudy ? (
      <>
        <ThemedCaseStudyChrome title={project.data.title} />
        <main class="custom-project-page">
          {
            isNexusWave ? (
              <NexusWaveCaseStudy
                project={caseStudyProject}
                relatedPosts={relatedPostCards}
              />
            ) : isMekbuda ? (
              <MekbudaCaseStudy
                project={caseStudyProject}
                relatedPosts={relatedPostCards}
              />
            ) : (
              <LatticeMatrixCaseStudy
                project={caseStudyProject}
                relatedPosts={relatedPostCards}
              />
            )
          }
        </main>
      </>
    ) : (
      <>
        <div class="theme-surface" data-theme-surface="modern">
          <ModernProjectDetail {...detailProps}>
            <Content />
          </ModernProjectDetail>
        </div>
        <div class="theme-surface" data-theme-surface="desktop">
          <DesktopProjectDetail {...detailProps}>
            <Content />
          </DesktopProjectDetail>
        </div>
        <div class="theme-surface" data-theme-surface="institutional">
          <InstitutionalProjectDetail {...detailProps}>
            <Content />
          </InstitutionalProjectDetail>
        </div>
        <div class="theme-surface" data-theme-surface="geocities">
          <GeoCitiesProjectDetail {...detailProps}>
            <Content />
          </GeoCitiesProjectDetail>
        </div>
        <div class="theme-surface" data-theme-surface="web2">
          <Web2ProjectDetail {...detailProps}>
            <Content />
          </Web2ProjectDetail>
        </div>
      </>
    )
  }
</BaseLayout>

<style>
  .custom-project-page {
    width: 100%;
    margin: 0;
    padding: clamp(1rem, 3vw, 2rem) 0 clamp(4.5rem, 7vw, 6rem);
  }
</style>
