---
import { getCollection } from "astro:content";

import ThemedProjectsIndex from "../../components/themes/shared/ThemedProjectsIndex.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort(
  (first, second) => first.data.order - second.data.order,
);
---

<BaseLayout
  title="Projects | PortfolioOS"
  description="Applications, experiments, and technical projects developed by Richard."
>
  <ThemedProjectsIndex projects={projects} />
</BaseLayout>
