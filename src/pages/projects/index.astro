---
import { getCollection } from "astro:content";

import ProjectCard from "../../components/shared/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort(
  (first, second) => first.data.order - second.data.order,
);
---

<BaseLayout
  title="Projects | PortfolioOS"
  description="Applications, experiments, and technical projects developed by Richard."
>
  <main class="content-page content-shell">
    <nav class="site-chrome-nav" aria-label="Content navigation">
      <a href="/">← PortfolioOS</a>
      <a href="/blog">Technical Journal</a>
    </nav>

    <header>
      <p class="eyebrow">PortfolioOS / Projects</p>
      <h1>Projects</h1>
      <p>
        Applications presented through feature demonstrations,
        technical explanations, architecture notes, and development
        articles.
      </p>
    </header>

    <div class="project-grid">
      {
        projects.map((project) => (
          <ProjectCard project={project} />
        ))
      }
    </div>

    <p class="todo-note">
      TODO(Codex): Build the complete projects explorer, filtering,
      feature-preview media, and XP-specific visual variant.
    </p>
  </main>
</BaseLayout>

<style>
  .content-page {
    width: min(100% - 2rem, 68rem);
    margin: 0 auto;
    padding: 2rem 0 4rem;
  }

  header {
    max-width: 48rem;
    margin: 1.5rem 0 2rem;
  }

  h1 {
    margin: 0;
    font-family: var(--site-font-heading, inherit);
    font-size: clamp(2rem, 6vw, 4rem);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
  }
</style>
