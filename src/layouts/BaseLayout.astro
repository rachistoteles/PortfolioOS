---
import "../styles/global.css";
import "../styles/themes/tokens.css";
import "../styles/themes/win98.css";
import "../styles/themes/institutional.css";
import "../styles/themes/geocities.css";
import "../styles/themes/web2.css";

import PortfolioTopBar from "../components/shared/PortfolioTopBar.astro";
import { DEFAULT_PORTFOLIO_THEME } from "../config/portfolioThemes";

interface Props {
  title: string;
  description: string;
  showTopBar?: boolean;
}

const { title, description, showTopBar = true } = Astro.props;
---

<!doctype html>
<html lang="en" data-portfolio-theme={DEFAULT_PORTFOLIO_THEME} data-theme="xp">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>

    <script is:inline>
      (function () {
        var key = "portfolio-theme";
        var allowed = [
          "modern",
          "xp",
          "win98",
          "institutional",
          "geocities",
          "web2",
        ];
        var saved = null;

        try {
          saved = localStorage.getItem(key);
        } catch (error) {
          saved = null;
        }

        var theme =
          allowed.indexOf(saved) !== -1 ? saved : "xp";

        document.documentElement.setAttribute(
          "data-portfolio-theme",
          theme,
        );
        document.documentElement.setAttribute(
          "data-theme",
          theme === "modern" ? "modern" : theme === "xp" ? "xp" : theme,
        );
      })();
    </script>
  </head>

  <body>
    <div class="portfolio-app">
      {showTopBar && <PortfolioTopBar />}
      <slot />
    </div>

    <!--
      TODO(Codex):
      Add shared metadata, Open Graph tags, canonical URLs,
      RSS discovery, sitemap integration, and structured data.
    -->
  </body>
</html>
